PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/visitor-pass-management
JWT_SECRET=replace_with_a_long_random_secret
NODE_ENV=production
# Comma-separated deployed frontend origins. Never use * in production.
CORS_ORIGINS=https://your-frontend.example.com

# Email notifications (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASS=replace_with_smtp_password
EMAIL_FROM=Visitor Pass <notifications@example.com>

# SMS notifications through Fast2SMS Quick SMS route (optional)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# One-time initial admin creation. Set these only for the first deployment,
# then remove BOOTSTRAP_ADMIN_PASSWORD from the deployment environment.
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_unique_8_plus_character_password

# Accounts should normally be created by an administrator. Keep this false
# in production unless this is a deliberately public, verified sign-up flow.
ALLOW_PUBLIC_REGISTRATION=false

# Keep false in production. This only enables the development bootstrap endpoint.
ALLOW_ADMIN_SEED=false
